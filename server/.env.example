# Copy these names into the hosting provider's Environment settings.
# Never commit real values or put server secrets in client/.env.
PORT=5000
JWT_SECRET=replace-with-a-long-random-secret
MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>/<database>?retryWrites=true&w=majority
AI_SERVICE_URL=https://your-ai-service.example.com
CLIENT_ORIGIN=https://your-frontend.example.com
